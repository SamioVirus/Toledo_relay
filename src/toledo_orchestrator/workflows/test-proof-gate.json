{
  "schema_version": "toledo_orchestrator.workflow.v2",
  "id": "test-proof-gate",
  "cadence": "daily",
  "label": "Test & Proof Gate · medium reasoning",
  "start_stage": "test-propose",
  "planning_round_cap": 2,
  "implementation_round_cap": 2,
  "next_task_stage": "test-next-task",
  "next_task_revision_stage": "test-next-task-revise",
  "profiles": {
    "test-planner": {
      "label": "5.6 Terra · Medium",
      "provider": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "permission": "read-only",
      "color": "#56c8ff",
      "timeout_seconds": 3600
    },
    "test-runner": {
      "label": "5.6 Terra · Medium",
      "provider": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "permission": "workspace-write",
      "color": "#61e6a8",
      "timeout_seconds": 3600
    },
    "test-reviewer": {
      "label": "Sonnet 5 · Medium",
      "provider": "claude",
      "model": "claude-sonnet-5",
      "effort": "medium",
      "permission": "read-only",
      "color": "#ffb15a",
      "timeout_seconds": 3600
    }
  },
  "stages": {
    "test-propose": {
      "title": "Map the proof obligation",
      "phase": "planning",
      "role": "planner",
      "prompt_kind": "test-propose",
      "prompt_label": "Proof plan",
      "prompt_file": "test-proof-planner.md",
      "profile": "test-planner",
      "session_slot": "test-planner",
      "session_policy": "new-if-missing",
      "artifact_type": "plan",
      "context": ["request", "stack-handoff", "human-decisions"],
      "round": {"counter": "planning", "cap": 2, "directive": "continue", "pause_reason": "planning_round_cap_reached"},
      "transitions": {"continue": "test-review", "ready": "test-review", "human": "@pause:provider_requested_human"}
    },
    "test-review": {
      "title": "Challenge coverage and signal",
      "phase": "planning-review",
      "role": "reviewer",
      "prompt_kind": "test-review",
      "prompt_label": "Coverage review",
      "prompt_file": "test-proof-reviewer.md",
      "profile": "test-reviewer",
      "session_slot": "test-reviewer",
      "session_policy": "new-if-missing",
      "artifact_type": "plan-review",
      "context": ["request", "latest:plan", "stack-handoff", "human-decisions"],
      "round": {"counter": "planning", "cap": 2, "directive": "continue", "pause_reason": "planning_round_cap_reached"},
      "seal_source": "plan",
      "transitions": {"continue": "test-revise", "ready": "@seal:approved-handoff:test-run", "human": "@pause:provider_requested_human"}
    },
    "test-revise": {
      "title": "Tighten the proof plan",
      "phase": "planning",
      "role": "planner",
      "prompt_kind": "test-adjudicate",
      "prompt_label": "Tighten",
      "prompt_file": "test-proof-adjudicator.md",
      "profile": "test-planner",
      "session_slot": "test-planner",
      "session_policy": "continue",
      "artifact_type": "plan",
      "context": ["request", "latest:plan", "latest:plan-review", "stack-handoff", "human-decisions"],
      "transitions": {"continue": "test-review", "ready": "test-review", "human": "@pause:provider_requested_human"}
    },
    "test-run": {
      "title": "Execute the bounded proof",
      "phase": "implementation",
      "role": "implementer",
      "prompt_kind": "test-run",
      "prompt_label": "Test",
      "prompt_file": "test-proof-runner.md",
      "profile": "test-runner",
      "session_slot": "test-runner",
      "session_policy": "new-if-missing",
      "artifact_type": "implementation-report",
      "context": ["approved-handoff", "stack-handoff"],
      "repair_stage": "test-repair",
      "transitions": {"continue": "test-audit", "ready": "test-audit", "human": "@pause:provider_requested_human"}
    },
    "test-audit": {
      "title": "Review the proof receipt",
      "phase": "implementation-review",
      "role": "reviewer",
      "prompt_kind": "test-audit",
      "prompt_label": "Audit",
      "prompt_file": "test-proof-auditor.md",
      "profile": "test-reviewer",
      "session_slot": "test-reviewer",
      "session_policy": "continue",
      "artifact_type": "implementation-review",
      "context": ["approved-handoff", "latest:implementation-report", "implementation-evidence", "stack-handoff", "human-decisions"],
      "round": {"counter": "implementation", "cap": 2, "directive": "continue", "pause_reason": "implementation_round_cap_reached"},
      "repair_stage": "test-repair",
      "transitions": {"continue": "test-repair", "ready": "@complete:test-next-task", "human": "@pause:provider_requested_human"}
    },
    "test-repair": {
      "title": "Repair the smallest proof gap",
      "phase": "implementation",
      "role": "implementer",
      "prompt_kind": "test-repair",
      "prompt_label": "Repair",
      "prompt_file": "test-proof-repair.md",
      "profile": "test-runner",
      "session_slot": "test-runner",
      "session_policy": "continue",
      "artifact_type": "implementation-report",
      "context": ["approved-handoff", "latest:implementation-report", "latest:implementation-review", "implementation-evidence", "stack-handoff", "human-decisions"],
      "repair_stage": "test-repair",
      "transitions": {"continue": "test-audit", "ready": "test-audit", "human": "@pause:provider_requested_human"}
    },
    "test-next-task": {
      "title": "Choose the next proof obligation",
      "phase": "next-task",
      "role": "reviewer",
      "prompt_kind": "test-next",
      "prompt_label": "Next",
      "prompt_file": "test-proof-next.md",
      "profile": "test-reviewer",
      "session_slot": "test-reviewer",
      "session_policy": "continue",
      "artifact_type": "next-task-proposal",
      "context": ["completion-receipt", "latest:implementation-review", "stack-handoff", "human-decisions"],
      "transitions": {"continue": "@pause:next_task_approval", "ready": "@pause:next_task_approval", "human": "@pause:next_task_approval"}
    },
    "test-next-task-revise": {
      "title": "Redirect the proof gate",
      "phase": "next-task",
      "role": "reviewer",
      "prompt_kind": "test-next-revise",
      "prompt_label": "Redirect",
      "prompt_file": "test-proof-next-revise.md",
      "profile": "test-reviewer",
      "session_slot": "test-reviewer",
      "session_policy": "continue",
      "artifact_type": "next-task-proposal",
      "context": ["completion-receipt", "latest:next-task-proposal", "stack-handoff", "human-decisions"],
      "transitions": {"continue": "@pause:next_task_approval", "ready": "@pause:next_task_approval", "human": "@pause:next_task_approval"}
    }
  }
}
