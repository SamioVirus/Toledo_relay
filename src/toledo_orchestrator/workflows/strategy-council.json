{
  "schema_version": "toledo_orchestrator.workflow.v2",
  "id": "strategy-council",
  "cadence": "weekly",
  "label": "Strategy Council · high-reasoning gate",
  "start_stage": "strategy-propose",
  "planning_round_cap": 2,
  "implementation_round_cap": 1,
  "next_task_stage": "strategy-next-task",
  "next_task_revision_stage": "strategy-next-task-revise",
  "profiles": {
    "strategy-planner": {
      "label": "5.6 Sol · Very high",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "xhigh",
      "permission": "read-only",
      "color": "#56c8ff",
      "timeout_seconds": 7200
    },
    "strategy-reviewer": {
      "label": "Sonnet 5 · Very high",
      "provider": "claude",
      "model": "claude-sonnet-5",
      "effort": "xhigh",
      "permission": "read-only",
      "color": "#ffb15a",
      "timeout_seconds": 7200
    },
    "strategy-operator": {
      "label": "5.6 Sol · High",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "permission": "workspace-write",
      "color": "#61e6a8",
      "timeout_seconds": 7200
    }
  },
  "stages": {
    "strategy-propose": {
      "title": "Reconstruct the strategic case",
      "phase": "planning",
      "role": "planner",
      "prompt_kind": "strategy-propose",
      "prompt_label": "Strategy",
      "prompt_file": "strategy-council-planner.md",
      "profile": "strategy-planner",
      "session_slot": "strategy-planner",
      "session_policy": "new-if-missing",
      "artifact_type": "plan",
      "context": ["request", "stack-handoff", "human-decisions"],
      "round": {"counter": "planning", "cap": 2, "directive": "continue", "pause_reason": "planning_round_cap_reached"},
      "transitions": {"continue": "strategy-review", "ready": "strategy-review", "human": "@pause:provider_requested_human"}
    },
    "strategy-review": {
      "title": "Challenge the strategy",
      "phase": "planning-review",
      "role": "reviewer",
      "prompt_kind": "strategy-review",
      "prompt_label": "Challenge",
      "prompt_file": "strategy-council-reviewer.md",
      "profile": "strategy-reviewer",
      "session_slot": "strategy-reviewer",
      "session_policy": "new-if-missing",
      "artifact_type": "plan-review",
      "context": ["request", "latest:plan", "stack-handoff", "human-decisions"],
      "round": {"counter": "planning", "cap": 2, "directive": "continue", "pause_reason": "planning_round_cap_reached"},
      "seal_source": "plan",
      "transitions": {"continue": "strategy-revise", "ready": "@seal:approved-handoff:strategy-operator", "human": "@pause:provider_requested_human"}
    },
    "strategy-revise": {
      "title": "Adjudicate the strategic disagreement",
      "phase": "planning",
      "role": "planner",
      "prompt_kind": "strategy-adjudicate",
      "prompt_label": "Adjudicate",
      "prompt_file": "strategy-council-adjudicator.md",
      "profile": "strategy-planner",
      "session_slot": "strategy-planner",
      "session_policy": "continue",
      "artifact_type": "plan",
      "context": ["request", "latest:plan", "latest:plan-review", "stack-handoff", "human-decisions"],
      "transitions": {"continue": "strategy-review", "ready": "strategy-review", "human": "@pause:provider_requested_human"}
    },
    "strategy-operator": {
      "title": "Package the approved strategy",
      "phase": "implementation",
      "role": "implementer",
      "prompt_kind": "strategy-package",
      "prompt_label": "Package",
      "prompt_file": "strategy-council-package.md",
      "profile": "strategy-operator",
      "session_slot": "strategy-operator",
      "session_policy": "new-if-missing",
      "artifact_type": "implementation-report",
      "context": ["approved-handoff", "stack-handoff"],
      "repair_stage": "strategy-repair",
      "transitions": {"continue": "strategy-audit", "ready": "strategy-audit", "human": "@pause:provider_requested_human"}
    },
    "strategy-audit": {
      "title": "Verify the strategic handoff",
      "phase": "implementation-review",
      "role": "reviewer",
      "prompt_kind": "strategy-audit",
      "prompt_label": "Verify",
      "prompt_file": "strategy-council-auditor.md",
      "profile": "strategy-reviewer",
      "session_slot": "strategy-reviewer",
      "session_policy": "continue",
      "artifact_type": "implementation-review",
      "context": ["approved-handoff", "latest:implementation-report", "implementation-evidence", "stack-handoff", "human-decisions"],
      "round": {"counter": "implementation", "cap": 1, "directive": "continue", "pause_reason": "implementation_round_cap_reached"},
      "repair_stage": "strategy-repair",
      "transitions": {"continue": "strategy-repair", "ready": "@complete:strategy-next-task", "human": "@pause:provider_requested_human"}
    },
    "strategy-repair": {
      "title": "Repair a verified strategy gap",
      "phase": "implementation",
      "role": "implementer",
      "prompt_kind": "strategy-repair",
      "prompt_label": "Repair",
      "prompt_file": "strategy-council-repair.md",
      "profile": "strategy-operator",
      "session_slot": "strategy-operator",
      "session_policy": "continue",
      "artifact_type": "implementation-report",
      "context": ["approved-handoff", "latest:implementation-report", "latest:implementation-review", "implementation-evidence", "stack-handoff", "human-decisions"],
      "repair_stage": "strategy-repair",
      "transitions": {"continue": "strategy-audit", "ready": "strategy-audit", "human": "@pause:provider_requested_human"}
    },
    "strategy-next-task": {
      "title": "Choose the next strategic layer",
      "phase": "next-task",
      "role": "reviewer",
      "prompt_kind": "strategy-next",
      "prompt_label": "Next",
      "prompt_file": "strategy-council-next.md",
      "profile": "strategy-reviewer",
      "session_slot": "strategy-reviewer",
      "session_policy": "continue",
      "artifact_type": "next-task-proposal",
      "context": ["completion-receipt", "latest:implementation-review", "stack-handoff", "human-decisions"],
      "transitions": {"continue": "@pause:next_task_approval", "ready": "@pause:next_task_approval", "human": "@pause:next_task_approval"}
    },
    "strategy-next-task-revise": {
      "title": "Redirect the strategic layer",
      "phase": "next-task",
      "role": "reviewer",
      "prompt_kind": "strategy-next-revise",
      "prompt_label": "Redirect",
      "prompt_file": "strategy-council-next-revise.md",
      "profile": "strategy-reviewer",
      "session_slot": "strategy-reviewer",
      "session_policy": "continue",
      "artifact_type": "next-task-proposal",
      "context": ["completion-receipt", "latest:next-task-proposal", "stack-handoff", "human-decisions"],
      "transitions": {"continue": "@pause:next_task_approval", "ready": "@pause:next_task_approval", "human": "@pause:next_task_approval"}
    }
  }
}
