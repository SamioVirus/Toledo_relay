{
  "schema_version": "toledo_orchestrator.workflow.v2",
  "id": "ui-studio",
  "cadence": "hourly",
  "label": "UI Studio · responsive acceptance",
  "start_stage": "ui-propose",
  "planning_round_cap": 2,
  "implementation_round_cap": 2,
  "next_task_stage": "ui-next-task",
  "next_task_revision_stage": "ui-next-task-revise",
  "profiles": {
    "ui-planner": {
      "label": "5.6 Sol · High",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "permission": "read-only",
      "color": "#56c8ff",
      "timeout_seconds": 5400
    },
    "ui-builder": {
      "label": "5.6 Sol · High",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "permission": "workspace-write",
      "color": "#61e6a8",
      "timeout_seconds": 5400
    },
    "ui-critic": {
      "label": "Sonnet 5 · Medium",
      "provider": "claude",
      "model": "claude-sonnet-5",
      "effort": "medium",
      "permission": "read-only",
      "color": "#ffb15a",
      "timeout_seconds": 5400
    }
  },
  "stages": {
    "ui-propose": {
      "title": "Frame the user-visible outcome",
      "phase": "planning",
      "role": "planner",
      "prompt_kind": "ui-propose",
      "prompt_label": "UI brief",
      "prompt_file": "ui-studio-planner.md",
      "profile": "ui-planner",
      "session_slot": "ui-planner",
      "session_policy": "new-if-missing",
      "artifact_type": "plan",
      "context": ["request", "stack-handoff", "human-decisions"],
      "round": {"counter": "planning", "cap": 2, "directive": "continue", "pause_reason": "planning_round_cap_reached"},
      "transitions": {"continue": "ui-review", "ready": "ui-review", "human": "@pause:provider_requested_human"}
    },
    "ui-review": {
      "title": "Critique the interaction and visual system",
      "phase": "planning-review",
      "role": "reviewer",
      "prompt_kind": "ui-review",
      "prompt_label": "Visual critique",
      "prompt_file": "ui-studio-reviewer.md",
      "profile": "ui-critic",
      "session_slot": "ui-critic",
      "session_policy": "new-if-missing",
      "artifact_type": "plan-review",
      "context": ["request", "latest:plan", "stack-handoff", "human-decisions"],
      "round": {"counter": "planning", "cap": 2, "directive": "continue", "pause_reason": "planning_round_cap_reached"},
      "seal_source": "plan",
      "transitions": {"continue": "ui-revise", "ready": "@seal:approved-handoff:ui-build", "human": "@pause:provider_requested_human"}
    },
    "ui-revise": {
      "title": "Resolve the visual trade-offs",
      "phase": "planning",
      "role": "planner",
      "prompt_kind": "ui-adjudicate",
      "prompt_label": "Resolve",
      "prompt_file": "ui-studio-adjudicator.md",
      "profile": "ui-planner",
      "session_slot": "ui-planner",
      "session_policy": "continue",
      "artifact_type": "plan",
      "context": ["request", "latest:plan", "latest:plan-review", "stack-handoff", "human-decisions"],
      "transitions": {"continue": "ui-review", "ready": "ui-review", "human": "@pause:provider_requested_human"}
    },
    "ui-build": {
      "title": "Implement the responsive slice",
      "phase": "implementation",
      "role": "implementer",
      "prompt_kind": "ui-build",
      "prompt_label": "Build",
      "prompt_file": "ui-studio-builder.md",
      "profile": "ui-builder",
      "session_slot": "ui-builder",
      "session_policy": "new-if-missing",
      "artifact_type": "implementation-report",
      "context": ["approved-handoff", "stack-handoff"],
      "repair_stage": "ui-repair",
      "transitions": {"continue": "ui-critic", "ready": "ui-critic", "human": "@pause:provider_requested_human"}
    },
    "ui-critic": {
      "title": "Verify the rendered experience",
      "phase": "implementation-review",
      "role": "reviewer",
      "prompt_kind": "ui-critic",
      "prompt_label": "Accept",
      "prompt_file": "ui-studio-critic.md",
      "profile": "ui-critic",
      "session_slot": "ui-critic",
      "session_policy": "continue",
      "artifact_type": "implementation-review",
      "context": ["approved-handoff", "latest:implementation-report", "implementation-evidence", "stack-handoff", "human-decisions"],
      "round": {"counter": "implementation", "cap": 2, "directive": "continue", "pause_reason": "implementation_round_cap_reached"},
      "repair_stage": "ui-repair",
      "transitions": {"continue": "ui-repair", "ready": "@complete:ui-next-task", "human": "@pause:provider_requested_human"}
    },
    "ui-repair": {
      "title": "Repair the smallest visible defect",
      "phase": "implementation",
      "role": "implementer",
      "prompt_kind": "ui-repair",
      "prompt_label": "Polish",
      "prompt_file": "ui-studio-repair.md",
      "profile": "ui-builder",
      "session_slot": "ui-builder",
      "session_policy": "continue",
      "artifact_type": "implementation-report",
      "context": ["approved-handoff", "latest:implementation-report", "latest:implementation-review", "implementation-evidence", "stack-handoff", "human-decisions"],
      "repair_stage": "ui-repair",
      "transitions": {"continue": "ui-critic", "ready": "ui-critic", "human": "@pause:provider_requested_human"}
    },
    "ui-next-task": {
      "title": "Choose the next user-facing improvement",
      "phase": "next-task",
      "role": "reviewer",
      "prompt_kind": "ui-next",
      "prompt_label": "Next",
      "prompt_file": "ui-studio-next.md",
      "profile": "ui-critic",
      "session_slot": "ui-critic",
      "session_policy": "continue",
      "artifact_type": "next-task-proposal",
      "context": ["completion-receipt", "latest:implementation-review", "stack-handoff", "human-decisions"],
      "transitions": {"continue": "@pause:next_task_approval", "ready": "@pause:next_task_approval", "human": "@pause:next_task_approval"}
    },
    "ui-next-task-revise": {
      "title": "Redirect the UI improvement",
      "phase": "next-task",
      "role": "reviewer",
      "prompt_kind": "ui-next-revise",
      "prompt_label": "Redirect",
      "prompt_file": "ui-studio-next-revise.md",
      "profile": "ui-critic",
      "session_slot": "ui-critic",
      "session_policy": "continue",
      "artifact_type": "next-task-proposal",
      "context": ["completion-receipt", "latest:next-task-proposal", "stack-handoff", "human-decisions"],
      "transitions": {"continue": "@pause:next_task_approval", "ready": "@pause:next_task_approval", "human": "@pause:next_task_approval"}
    }
  }
}
